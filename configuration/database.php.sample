	# On dev hosts, dbname and dbhost will be used in include/freshports.php and
	# displayed at the top of the page for debugging purposes.
	# The password is deliberately not kept in a variable.
	$dbname = "freshports.dev";
	$dbhost = "pg02.example.org";
	$dbuser = "www_dev";

	# The @ stops PHP writing its own warning for a failed connection; the
	# reason from that warning goes into our single syslog line below instead.
	$db = @pg_connect("dbname=$dbname host=$dbhost user=$dbuser password=SecretPW sslmode=require");
	if ($db) {
#		echo 'database connected';
	} else {
#		echo 'database connection failed';
		# pg_last_error() needs a connection, so take the reason (too many
		# clients, connection refused, authentication failed, timeout, ...)
		# from the warning pg_connect() raised. It spans several lines; keep
		# it to one syslog line. Never shown to the client.
		$reason = error_get_last()['message'] ?? 'no reason given';
		$reason = preg_replace('/^pg_connect\(\): /', '', $reason);
		$reason = preg_replace('/\s+/', ' ', trim($reason));

		header('HTTP/1.1 503 Service Temporarily Unavailable');
		header('Status: 503 Service Temporarily Unavailable');
		header('Retry-After: 300');//300 seconds
		syslog(LOG_ERR, 'Database connection failure: ' . $reason);
		die('Status: 503 Service Temporarily Unavailable');
	}

	$Statistics->DBSet($db);
