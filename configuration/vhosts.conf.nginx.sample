# The client address.  Visitors reach this server through one or two front
# proxies (proxy01 and/or the site's own proxy), so without this every request
# would appear to come from a proxy: the logs, the rate limits below and the
# PHP code would all see the proxy's address.  Each proxy appends to
# X-Forwarded-For; with real_ip_recursive on, nginx walks that list from the
# right, skipping the trusted proxies below, and uses the first address that
# isn't one of them.  Proxy addresses differ per site, which is why this is
# here and not in virtualhost-common.conf.  It is in the http context, so it
# covers every server block below.
set_real_ip_from  10.55.0.24;
set_real_ip_from  10.140.0.180;
real_ip_header    X-Forwarded-For;
real_ip_recursive on;

# The bot gate - see include/bot-gate.php, virtualhost-common.conf and
# https://github.com/FreshPorts/freshports/issues/692
# https://github.com/FreshPorts/freshports/issues/732
# https://news.freshports.org/2026/10/16/deterring-bots-but-letting-people-in/
#
# Someone with neither the login cookie (visitor) nor the bot gate cookie
# (bot_gate_ok) is sent to bot-gate.php, which shows a challenge without
# touching the database.

# commit.php and vuxml.php: every request
map "$cookie_visitor|$cookie_bot_gate_ok" $fp_bot_gate_page {
  default      0;
  "|"          1;
}

# search.php: only an actual search; the empty search form is fine for anyone
map "$cookie_visitor|$cookie_bot_gate_ok|$arg_query" $fp_bot_gate_search {
  default      0;
  "~^\|\|.+"   1;
}

# User agents to refuse (403) on this site.  virtualhost-common.conf checks
# $block_user_agent in every server block, so this map must exist on every
# site, even if it blocks nothing (keep only "default 0;").  A plain string
# must equal the whole User-Agent header, so a crawler's name alone never
# matches; use ~* to match part of the header, ignoring case.  These are
# crawlers and scrapers with no benefit to FreshPorts.  Search engines and
# feed readers are deliberately not listed.
map $http_user_agent $block_user_agent {
  default                 0;
  ""                      1;  # empty user agent
  ~*sogou                 1;
  ~*yisouspider           1;
  ~*bytespider            1;
  ~*tiktokspider          1;
  ~*baiduspider           1;
  ~*databankmetasearch    1;
}

# the format of /var/log/nginx/access_json.log, which is read into VictoriaLogs.
# used by virtualhost-common.conf

log_format victorialogs_json escape=json '{'
    '"_time":"$time_iso8601",'
    '"_msg":"$request",'
    '"status":"$status",'
    '"remote_addr":"$remote_addr",'
    '"body_bytes_sent":"$body_bytes_sent",'
    '"request_time":"$request_time",'
    '"http_user_agent":"$http_user_agent",'
    '"app":"nginx",'
    '"http_referer":"$http_referer",'
    '"request_method":"$request_method",'
    '"host":"$host",'
    '"hostname":"$hostname",'
    '"server_name":"$server_name"'
'}';

# this sets rate limiting
# both zones are used by virtualhost-common.conf

# protecting repeated login attempts
limit_req_zone $binary_remote_addr zone=auth_limit:20m rate=5r/m;

# cut down the abusers who raise the database CPU utilization
limit_req_zone $binary_remote_addr zone=root_limit:15m rate=40r/m;

server {
  listen 127.163.0.80:80;
  listen [fd00::80]:80;

  server_name   freshports.org;

  include "/usr/local/etc/freshports/virtualhost-common.conf";

  return 301 https://$server_name$request_uri;
}

server {
  listen 127.163.0.80:80;
  listen [fd00::80]:80;

  server_name   aws-1.freshports.org;

  include "/usr/local/etc/freshports/virtualhost-common.conf";

  return 301 https://$server_name$request_uri;
}

server {
  listen 127.163.0.80:443 ssl;
  listen [fd00::80]:443   ssl;
  http2 on;
  
  server_name   freshports.org;

  include "/usr/local/etc/freshports/virtualhost-common.conf";
  include "/usr/local/etc/freshports/virtualhost-common-ssl.conf";

  ssl_certificate     /usr/local/etc/ssl/aws-1.freshports.org.fullchain.cer;
  ssl_certificate_key /usr/local/etc/ssl/aws-1.freshports.org.key;

  return 301 https://$server_name$request_uri;
}

server {
  listen 127.163.0.80:443 ssl;
  listen [fd00::80]:443   ssl;
  http2 on;
  
  server_name   aws-1.freshports.org;

  include "/usr/local/etc/freshports/virtualhost-common.conf";
  include "/usr/local/etc/freshports/virtualhost-common-ssl.conf";

  ssl_certificate     /usr/local/etc/ssl/aws-1.freshports.org.fullchain.cer;
  ssl_certificate_key /usr/local/etc/ssl/aws-1.freshports.org.key;
}
