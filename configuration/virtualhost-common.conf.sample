  root          /usr/local/www/freshports/www/;
  index         index.php index.html index.htm;

  # the client address from the front proxy (real_ip) is set per site, in vhosts.conf.nginx

  gzip on;
  gzip_vary on;
  gzip_http_version 1.1;
  gzip_comp_level 6;
  gzip_types text/plain text/css text/javascript text/xml application/javascript application/json application/xml application/xml+rss;

  error_log	/var/log/nginx/freshports.org-error.log;
  access_log	/var/log/nginx/freshports.org-access.log combined;

  # Send JSON format to a log agent or Syslog endpoint handled by VictoriaLogs
  access_log    /var/log/nginx/access_json.log victorialogs_json;

  # Drop the Lightpanda headless browser. On 2026-11-11 it sent dev about
  # 2,900 requests in two minutes, and on 2026-11-19 at 05:03 UTC it sent
  # r720-02 about 8,400 requests in 40 seconds from 8,191 rotating IPs,
  # mostly search.php and vuxml.php. Both times it used up the database
  # connections and normal pages returned 502. It sends no referer, so
  # only its user agent identifies it.
  if ($http_user_agent ~* "lightpanda") { return 444; }

  # Drop requests whose Referer is a bare origin ("https://host", no path, no
  # trailing slash). Browsers always send at least "https://host/", so only a
  # client faking its referer sends this. On 2026-11-10 a scraper used it with
  # rotating residential IPs and faked browser user agents: about 2,400
  # search.php requests in one minute to fresherports.org (stage) at 02:12 UTC
  # and about 6,950 to www.freshports.org (prod) during the 07:00 UTC hour.
  # Both exhausted the database connections and caused 502s on normal pages.
  # UptimeRobot also sends a bare-origin referer, so it is exempted.
  set $bare_origin 0;
  if ($http_referer ~ "^https?://[^/]+$") { set $bare_origin 1; }
  if ($http_user_agent ~ "UptimeRobot") { set $bare_origin 0; }
  if ($bare_origin) { return 444; }

  # /.well-known/ (security.txt, keys, ACME challenges) stays public.  ^~
  # stops the regex locations below, including the deny, from applying.
  location ^~ /.well-known/ {
    try_files $uri $uri/ =404;
  }

  # Only pages and assets are for visitors.  Anything else in the document
  # root would be sent as a plain file: dotfiles such as .gitignore, macOS
  # ._ files, editor backups ending in ~, and PHP include files (*.inc) as
  # source.  Include files belong in ../include, outside the document
  # root; this catches any which end up here.  This must come before
  # "location ~ \.php$", or a ._name.php file is run as PHP.  404, not 403,
  # so a probe learns nothing about what exists.
  #
  # Only refuse what is really on disk (-e, so a dot-directory such as
  # .git/ is refused too).  Anything else is a FreshPorts URL, not a file:
  # ports-tree files such as korean/Makefile.inc or a top-level .gitignore
  # have pages, so they go on to the URL parser as in "location /" below.
  location ~ (/\.|\.inc$|~$) {
    if (-e $request_filename) {
      return 404;
    }
    try_files $uri /--/url-parser.php;
  }

  location ~ ^/(login|forgotten-password|password-reset-via-token)\.php$  {
    limit_req zone=auth_limit burst=5;
    include /usr/local/www/freshports/configuration/php-processing.conf;
  }

  # phorum didn't have releases for a long time.
  # so I dropped it as would no longer run.
  location ~ ^/phorum/(.*)$ {
    try_files $uri /--/forums-gone.php;
  }

  # The 2007 design contest voting pages were removed in November 2026.
  # Old blog posts and search engines still link to /DesignContestVoting/,
  # so it, and everything below it (the A/ and B/ mock-ups), redirects
  # permanently to the blog post which announced the contest.
  location ^~ /DesignContestVoting {
    return 301 https://news.freshports.org/2007/01/30/freshports-design-contest/;
  }

  # the commits.php page has been retired
  rewrite ^/commits.php / permanent;

  # Drop a scraper whose search URL template is missing its '&' separators
  # (sends e.g. "stype=maintainermethod=exactquery=<email>" or
  # "stype=depends_allmethod=matchquery=<port>" instead of
  # "stype=maintainer&method=exact&query=<email>"). It runs searches slowly
  # from rotating AWS addresses with faked user agents and a faked
  # http://www.freshports.org/ referer. These requests can only ever get
  # the "bad search string" page, so close the connection without a
  # response (444) instead of passing them to PHP and logging each one.
  # First seen 2026-10-22 on aws-1-nginx01.
  if ($args ~ "stype=[a-z_]+[^&]*method=") { return 444; }

  # commit.php and vuxml.php: without a login or the bot gate cookie, show the
  # bot gate's challenge, before the page itself and the database run.
  # See $fp_bot_gate_page in vhosts.conf.nginx and
  # https://github.com/FreshPorts/freshports/issues/732
  #
  location ~ ^/(commit|vuxml)\.php$ {
    if ($fp_bot_gate_page) {
      rewrite ^ /bot-gate.php last;
    }
    include /usr/local/www/freshports/configuration/php-processing.conf;
  }

  # see $fp_bot_gate_search in vhosts.conf.nginx
  location = /search.php {
    if ($fp_bot_gate_search) {
      rewrite ^ /bot-gate.php last;
    }
    include /usr/local/www/freshports/configuration/php-processing.conf;
  }

  location ~ \.php$ {
    include /usr/local/www/freshports/configuration/php-processing.conf;
  }

  # css files are appended with a content hash so have long expiry
  location /css/ {
    expires 2y;
    try_files $uri $uri/ =404;
  }

  # jquery libs and most images are relatively static
  location ~ /(javascript/jquery.+\.js|images/[^/]+\.(png|gif|jpg))$ {
    expires 6M;
    try_files $uri $uri/ =404;
  }

  location / {
    limit_req zone=root_limit burst=60 nodelay;
    limit_req_status 429;
    try_files $uri $uri/ /--/url-parser.php;
  }
