






  root          /usr/local/www/freshports/www/;
  index         index.php index.html index.htm;

  # the client address comes from the front proxy; set this to that proxy's address
  set_real_ip_from  10.55.0.24/32;
  real_ip_header    X-Real-IP;
  real_ip_recursive on;

  gzip on;
  gzip_vary on;
  gzip_http_version 1.1;
  gzip_comp_level 6;
  gzip_types text/plain text/css text/javascript text/xml application/javascript application/json application/xml application/xml+rss;

  error_log	/var/log/nginx/freshports.org-error.log;
  access_log	/var/log/nginx/freshports.org-access.log combined;

  # Send JSON format to a log agent or Syslog endpoint handled by VictoriaLogs
  access_log    /var/log/nginx/access_json.log victorialogs_json;

  # /.well-known/ (security.txt, keys, ACME challenges) stays public.  ^~
  # stops the regex locations below, including the deny, from applying.
  location ^~ /.well-known/ {
    try_files $uri $uri/ =404;
  }

  # Only pages and assets are for visitors.  Anything else in the document
  # root would be sent as a plain file: dotfiles such as .gitignore, macOS
  # ._ files, editor backups ending in ~, and PHP include files (*.inc) as
  # source.  Include files belong in ../include, outside the document
  # root; this catches any which end up here.  This must come before
  # "location ~ \.php$", or a ._name.php file is run as PHP.  404, not 403,
  # so a probe learns nothing about what exists.
  location ~ (/\.|\.inc$|~$) {
    return 404;
  }

  location ~ ^/(login|forgotten-password|password-reset-via-token)\.php$  {
    limit_req zone=auth_limit burst=5;
    include /usr/local/www/freshports/configuration/php-processing.conf;
  }

  # phorum didn't have releases for a long time.
  # so I dropped it as would no longer run.
  location ~ ^/phorum/(.*)$ {
    try_files $uri /--/forums-gone.php;
  }

  # The 2007 design contest voting pages were removed in November 2026.
  # Old blog posts and search engines still link to /DesignContestVoting/,
  # so it, and everything below it (the A/ and B/ mock-ups), redirects
  # permanently to the blog post which announced the contest.
  location ^~ /DesignContestVoting {
    return 301 https://news.freshports.org/2007/01/30/freshports-design-contest/;
  }

  # the commits.php page has been retired
  rewrite ^/commits.php / permanent;

  # commit.php and vuxml.php: without a login or the bot gate cookie, show the
  # bot gate's challenge, before the page itself and the database run.
  # See $fp_bot_gate_page in vhosts.conf.nginx and
  # https://github.com/FreshPorts/freshports/issues/732
  #
  location ~ ^/(commit|vuxml)\.php$ {
    if ($fp_bot_gate_page) {
      rewrite ^ /bot-gate.php last;
    }
    include /usr/local/www/freshports/configuration/php-processing.conf;
  }

  # see $fp_bot_gate_search in vhosts.conf.nginx
  location = /search.php {
    if ($fp_bot_gate_search) {
      rewrite ^ /bot-gate.php last;
    }
    include /usr/local/www/freshports/configuration/php-processing.conf;
  }

  location ~ \.php$ {
    include /usr/local/www/freshports/configuration/php-processing.conf;
  }

  # css files are appended with a content hash so have long expiry
  location /css/ {
    expires 2y;
    try_files $uri $uri/ =404;
  }

  # jquery libs and most images are relatively static
  location ~ /(javascript/jquery.+\.js|images/[^/]+\.(png|gif|jpg))$ {
    expires 6M;
    try_files $uri $uri/ =404;
  }

  location / {
    limit_req zone=root_limit burst=60 nodelay;
    limit_req_status 429;
    try_files $uri $uri/ /--/url-parser.php;
  }
