<?php
  # This is a sample file and you need to copy it to constants.local.php for
  # it to be effective.
  #
  # This file contains overrides to the constants.php file and allows
  # constants to vary from instance to instance.
  # Not all contants can be overridden, only those declared with if (!defined())
  # constants which 

#define('PATH_TO_PORTSDIR', '/usr/local/');  // must have a trailing /
#define('FRESHPORTS_LOG_CACHE_ACTIVITY', 1);

# comment out this line to allow logins. the value does not matter.
#define('NO_LOGIN', false);

# set this to true to display the now-in-maintenance-mode.php page
# users get redirected there if visit the following pages:
# * bouncing.php
# * customize.php
# * committer-opt-in.php
# * filter-setup.php
# * forgotten-password.php
# * new-user.php
# * password-reset-via-token.php
# * pkg_upload.php
# * port-watch.php
# * report-subscriptions.php
# * watch-categories.php
# * watch-list-maintenance.php
# * watch-list.php
#
define('IN_MAINTENANCE_MODE', false);

# if defined, and non-empty, parse out the UCL messages
define('PKG_MESSAGE_UCL', 1);

define('MAX_LOAD_SEARCH', 3.75);
define('MAX_LOAD_COMMIT', 3.752);

define('MAIL_SERVER', 'localhost');

define('UKRAINE', '1');

#
# for include/htmlify.php
#
define('HTMLIFY_USE_URL_HIGHLIGHT',     false);
define('HTMLIFY_USE_LIB_AUTOLINK',      true);

# url-highlight 4.x from the www/php-url-highlight package; takes
# precedence over the two above
define('HTMLIFY_USE_URL_HIGHLIGHT_PORT', false);
# only if the package is installed somewhere else
#define('URL_HIGHLIGHT_PORT_DIR', '/usr/local/share/pear/VStelmakh/UrlHighlight/');

define('HTMLIFY_PROCESS_PRS', true);

define('INCLUDE_GOOGLE_GTAG', false);

# re https://github.com/FreshPorts/freshports/issues/655
define('LOGIN_TO_VIEW_COMMIT', true);
define('LOGIN_TO_SEARCH',      true);  # ignored when BOT_GATE_SECRET is set - re #692
define('LOGIN_TO_VIEW_VUXML',  true);

# Deter bots from search.php, commit.php and vuxml.php - see include/bot-gate.php,
# https://github.com/FreshPorts/freshports/issues/692 and
# https://github.com/FreshPorts/freshports/issues/732
# When set, LOGIN_TO_SEARCH, LOGIN_TO_VIEW_COMMIT and LOGIN_TO_VIEW_VUXML are ignored.
# SEARCH_GATE_SECRET, the old name, is still read when this is not defined.
# Leave it empty, or undefined, to turn the gate off.
# Generate a value with: openssl rand -hex 32
# Changing it makes everyone's bot_gate_ok cookie invalid.
#define('BOT_GATE_SECRET', '');

# On a 404 for category/port, suggest ports the user might have meant.
# Defaults to true. See https://github.com/FreshPorts/freshports/issues/614
#define('PORT_SUGGESTIONS_ON_404', false);
